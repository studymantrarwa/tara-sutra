{
  "version": 2,
  "builds": [
    {"src":"api/index.js","use":"@vercel/node"},
    {"src":"api/ephemeris.py","use":"@vercel/python"},
    {"src":"public/**","use":"@vercel/static"}
  ],
  "routes": [
    {"src":"^/api/ephemeris$","dest":"/api/ephemeris.py"},
    {"src":"^/api/index$","dest":"/api/index.js"},
    {"src":"^/api/(.*)$","dest":"/api/index.js?route=$1"},
    {"handle":"filesystem"},
    {"src":"/(.*)","dest":"/public/$1"}
  ],
  "functions": {"api/ephemeris.py": {"maxDuration": 60}}
}
